# Compliant: CMK-encrypted volume, instance root disk, DR copy with a constant CMK ARN, launch template disk; deleting an old unencrypted volume is allowed.
resource_changes = {
	"aws_ebs_volume.data": {
		"address":       "aws_ebs_volume.data",
		"type":          "aws_ebs_volume",
		"mode":          "managed",
		"provider_name": "registry.terraform.io/hashicorp/aws",
		"change": {
			"actions": [
				"create",
			],
			"after": {
				"region":    "eu-west-1",
				"encrypted": true,
			},
			"after_unknown": {
				"kms_key_id": true,
			},
		},
	},
	"aws_instance.app": {
		"address":       "aws_instance.app",
		"type":          "aws_instance",
		"mode":          "managed",
		"provider_name": "registry.terraform.io/hashicorp/aws",
		"change": {
			"actions": [
				"create",
			],
			"after": {
				"region":        "eu-west-1",
				"instance_type": "t3.micro",
				"metadata_options": [
					{
						"http_endpoint":               "enabled",
						"http_tokens":                 "required",
						"http_put_response_hop_limit": 1,
					},
				],
				"root_block_device": [
					{
						"encrypted":   true,
						"volume_size": 8,
					},
				],
			},
			"after_unknown": {},
		},
	},
	"aws_ebs_snapshot_copy.dr": {
		"address":       "aws_ebs_snapshot_copy.dr",
		"type":          "aws_ebs_snapshot_copy",
		"mode":          "managed",
		"provider_name": "registry.terraform.io/hashicorp/aws",
		"change": {
			"actions": [
				"create",
			],
			"after": {
				"region":    "eu-west-1",
				"encrypted": true,
			},
			"after_unknown": {
				"kms_key_id": true,
			},
		},
	},
	"aws_launch_template.app": {
		"address":       "aws_launch_template.app",
		"type":          "aws_launch_template",
		"mode":          "managed",
		"provider_name": "registry.terraform.io/hashicorp/aws",
		"change": {
			"actions": [
				"create",
			],
			"after": {
				"region": "eu-west-1",
				"block_device_mappings": [
					{
						"device_name": "/dev/xvda",
						"ebs": [
							{
								"encrypted": "true",
							},
						],
					},
				],
				"metadata_options": [
					{
						"http_endpoint":               "enabled",
						"http_tokens":                 "required",
						"http_put_response_hop_limit": 1,
					},
				],
				"instance_type": "t3.small",
			},
			"after_unknown": {},
		},
	},
	"aws_ebs_volume.legacy": {
		"address":       "aws_ebs_volume.legacy",
		"type":          "aws_ebs_volume",
		"mode":          "managed",
		"provider_name": "registry.terraform.io/hashicorp/aws",
		"change": {
			"actions": [
				"delete",
			],
			"after": null,
			"after_unknown": {
				"kms_key_id": true,
			},
		},
	},
}
