# Configuration for: Compliant: CMK-encrypted volume, instance root disk, DR copy with a constant CMK ARN, launch template disk; deleting an old unencrypted volume is allowed.
resources = {
	"aws_ebs_volume.data": {
		"address":        "aws_ebs_volume.data",
		"type":           "aws_ebs_volume",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"encrypted": {
				"constant_value": true,
			},
			"kms_key_id": {
				"references": [
					"aws_kms_key.primary.arn",
					"aws_kms_key.primary",
				],
			},
		},
	},
	"aws_instance.app": {
		"address":        "aws_instance.app",
		"type":           "aws_instance",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"instance_type": {
				"constant_value": "t3.micro",
			},
			"root_block_device": [
				{
					"encrypted": {
						"constant_value": true,
					},
					"kms_key_id": {
						"references": [
							"aws_kms_key.primary.arn",
							"aws_kms_key.primary",
						],
					},
				},
			],
		},
	},
	"aws_ebs_snapshot_copy.dr": {
		"address":        "aws_ebs_snapshot_copy.dr",
		"type":           "aws_ebs_snapshot_copy",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"encrypted": {
				"constant_value": true,
			},
			"kms_key_id": {
				"constant_value": "arn:aws:kms:eu-central-1:111122223333:key/1234abcd-12ab-34cd-56ef-1234567890ab",
			},
		},
	},
	"aws_launch_template.app": {
		"address":        "aws_launch_template.app",
		"type":           "aws_launch_template",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"block_device_mappings": [
				{
					"device_name": {
						"constant_value": "/dev/xvda",
					},
					"ebs": [
						{
							"encrypted": {
								"constant_value": "true",
							},
							"kms_key_id": {
								"references": [
									"aws_kms_key.primary.arn",
									"aws_kms_key.primary",
								],
							},
						},
					],
				},
			],
		},
	},
	"aws_ebs_volume.legacy": {
		"address":        "aws_ebs_volume.legacy",
		"type":           "aws_ebs_volume",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"encrypted": {
				"constant_value": false,
			},
		},
	},
}

providers = {}

module_calls = {}
