# Compliant: t3.micro instance, t3.small launch template, and a launch template without a type.
resource_changes = {
	"aws_instance.app": {
		"address":       "aws_instance.app",
		"type":          "aws_instance",
		"mode":          "managed",
		"provider_name": "registry.terraform.io/hashicorp/aws",
		"change": {
			"actions": [
				"create",
			],
			"after": {
				"region":        "eu-west-1",
				"instance_type": "t3.micro",
				"metadata_options": [
					{
						"http_endpoint":               "enabled",
						"http_tokens":                 "required",
						"http_put_response_hop_limit": 1,
