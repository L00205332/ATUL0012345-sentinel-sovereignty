# Configuration for: Non-compliant: IMDSv2 required, but hop limit 2 lets containers on the host reach the metadata service.
resources = {
	"aws_instance.app": {
		"address":        "aws_instance.app",
		"type":           "aws_instance",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"instance_type": {
				"constant_value": "t3.micro",
			},
			"root_block_device": [
				{
					"encrypted": {
						"constant_value": true,
					},
					"kms_key_id": {
						"references": [
							"aws_kms_key.primary.arn",
							"aws_kms_key.primary",
						],
					},
				},
			],
		},
	},
}

providers = {}

module_calls = {}
