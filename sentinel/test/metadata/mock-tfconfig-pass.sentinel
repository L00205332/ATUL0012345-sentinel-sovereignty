# Configuration for: Compliant: IMDSv2 required with hop limit 1 on an instance and a launch template; an instance with the metadata service disabled entirely.
resources = {
	"aws_instance.app": {
		"address":        "aws_instance.app",
		"type":           "aws_instance",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"instance_type": {
				"constant_value": "t3.micro",
			},
			"root_block_device": [
				{
					"encrypted": {
						"constant_value": true,
					},
					"kms_key_id": {
						"references": [
							"aws_kms_key.primary.arn",
							"aws_kms_key.primary",
						],
					},
				},
			],
		},
	},
	"aws_launch_template.app": {
		"address":        "aws_launch_template.app",
		"type":           "aws_launch_template",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"block_device_mappings": [
				{
					"device_name": {
						"constant_value": "/dev/xvda",
					},
					"ebs": [
						{
							"encrypted": {
								"constant_value": "true",
							},
							"kms_key_id": {
								"references": [
									"aws_kms_key.primary.arn",
									"aws_kms_key.primary",
								],
							},
						},
					],
				},
			],
		},
	},
	"aws_instance.no_imds": {
		"address":        "aws_instance.no_imds",
		"type":           "aws_instance",
		"mode":           "managed",
		"module_address": "",
		"config": {
			"instance_type": {
				"constant_value": "t3.micro",
			},
			"root_block_device": [
				{
					"encrypted": {
						"constant_value": true,
					},
					"kms_key_id": {
						"references": [
							"aws_kms_key.primary.arn",
							"aws_kms_key.primary",
						],
					},
				},
			],
		},
	},
}

providers = {}

module_calls = {}
