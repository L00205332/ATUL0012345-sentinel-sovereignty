			"outputs": {
				"data_volume_id": {
					"description": "Sensitive data volume ID.",
					"expression": {
						"references": [
							"aws_ebs_volume.data.id",
							"aws_ebs_volume.data",
						],
					},
				},
				"dr_snapshot_id": {
					"description": "Backup copy in the DR region.",
					"expression": {
						"references": [
							"aws_ebs_snapshot_copy.data_dr.id",
							"aws_ebs_snapshot_copy.data_dr",
						],
					},
				},
				"instance_id": {
					"description": "EC2 instance ID (connect with: aws ssm start-session --target <id>).",
					"expression": {
						"references": [
							"aws_instance.app.id",
							"aws_instance.app",
						],
					},
				},
				"primary_snapshot_id": {
					"description": "Backup snapshot in the primary region.",
					"expression": {
						"references": [
							"aws_ebs_snapshot.data.id",
							"aws_ebs_snapshot.data",
						],
					},
				},
				"regions": {
					"description": "Regions used by this stack.",
					"expression": {
						"references": [
							"var.primary_region",
							"var.dr_region",
						],
					},
				},
			},
			"resources": [
				{
					"address": "aws_ebs_snapshot.data",
					"expressions": {
						"description": {
							"references": [
								"local.name",
								"var.primary_region",
							],
						},
						"tags": {
							"references": [
								"local.name",
							],
						},
						"volume_id": {
							"references": [
								"aws_ebs_volume.data.id",
								"aws_ebs_volume.data",
							],
						},
					},
					"mode":                "managed",
					"name":                "data",
					"provider_config_key": "aws",
					"schema_version":      0,
					"type":                "aws_ebs_snapshot",
				},
				{
					"address": "aws_ebs_snapshot_copy.data_dr",
					"expressions": {
						"description": {
							"references": [
								"local.name",
								"var.dr_region",
							],
						},
						"encrypted": {
